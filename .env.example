# Heimdall — environment configuration (example)
# Copy to ~/.heimdall/env, or export the values in another process manager.
# Values shown are defaults unless marked "Required".

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3033                       # HTTP port
HEIMDALL_BIND=127.0.0.1         # safe default; put authenticated ingress in front if needed
DB_PATH=                        # path to Heimdall's SQLite DB (default: app-relative)
HEIMDALL_CONFIG_PATH=           # optional service/fleet JSON; default: ./heimdall.config.json
HEIMDALL_LOCAL_HOST_ID=control-node

# ── Munin (memory) ───────────────────────────────────────────────────────────
MUNIN_API_KEY=                  # Bearer for the Munin HTTP API

# ── M5 inference gateway (home-server) ───────────────────────────────────────
# The collector polls the BosGame M5 home-server gateway for /healthz liveness and
# the /ledger capability summary, surfaced on the dashboard "M5 Inference" card.
# On the Pi, point this at the M5's Tailscale URL. Unset → defaults to loopback
# (wrong on the Pi: M5 is a separate node) → the card shows "Down".
HOMESERVER_GATEWAY_URL=http://192.0.2.30:8080   # RFC 5737 example; replace or leave unset
HOMESERVER_GATEWAY_API_KEY=     # optional Bearer for /ledger (sent only if set)
# The /m5 ("What We've Learned") page reuses the two vars above for live /ledger + a fresh
# mellum-generated summary. Optional snapshot for its Routing panel (falls back to a
# live-ledger-derived hint if unset/missing):
M5_ROUTING_JSON_PATH=           # optional: absolute path to a routing snapshot JSON (docs/m5-routing.json)

# ── Operator notifications: Telegram via Ratatoskr ───────────────────────────
# Terminal-task outcomes and newly-fired critical alerts route to Telegram through
# Ratatoskr's local endpoint (see src/notify.js). Critical-alert delivery is persisted:
# repeats stay quiet, transport failures retry with backoff, and recovery permits re-fire.
# The legacy MS-Graph email path was RETIRED in #23 (Microsoft consumer-account abuse
# block, AADSTS70000). Do NOT reintroduce MICROSOFT_MCP_CLIENT_ID / NOTIFY_EMAIL /
# NOTIFY_ENABLED / HEIMDALL_API_KEY — they are dead and read by no code.
HEIMDALL_NOTIFY_CHAT_ID=        # Required to send task and critical-alert notifications
RATATOSKR_URL=http://127.0.0.1:3034/api/send   # optional; default shown
RATATOSKR_SEND_API_KEY=         # optional Bearer (loopback needs none; for non-loopback ratatoskr auth)

# ── Fleet telemetry ingest (v2 push-agent) ───────────────────────────────────
# Push-agents on each machine POST host metrics to /api/fleet/push. The endpoint
# is FAIL-CLOSED: a Bearer token is REQUIRED by default (even on a loopback bind,
# since a reverse proxy / tunnel forwarding to loopback would otherwise expose it).
HEIMDALL_FLEET_TOKEN=                       # shared/per-agent Bearer token (REQUIRED in any real deploy)
HEIMDALL_FLEET_ALLOW_INSECURE_LOOPBACK=     # set to 1 ONLY for localhost-only dev with no token

# Alert bus (P3): services / Ratatoskr POST the standard alert envelope to
# /api/alerts. Same fail-closed Bearer posture as fleet push. Coordinate token
# rotation with every sender; see docs/alert-token-operations.md.
HEIMDALL_ALERT_TOKEN=                       # Bearer token for POST /api/alerts (REQUIRED in any real deploy)
HEIMDALL_ALERT_ALLOW_INSECURE_LOOPBACK=     # set to 1 ONLY for localhost-only dev with no token
HEIMDALL_ALERT_STALE_HOURS=                 # hours an active alert may go un-re-asserted before it is
                                            # auto-closed as "stale — no data" (default 6). An alert whose
                                            # host or metric stopped reporting can never be resolved by its
                                            # evaluator; this is what stops it firing forever.

# ── Brokkr maintenance execution evidence (read-only observer) ─────────────
# POST /api/maintenance-execution-results accepts only the closed Brokkr v1
# result contract. It always requires this dedicated Bearer token, including on
# loopback; there is deliberately no insecure-loopback override. The evidence
# card does not control liveness, alerts, promotion, or any actuator. v1 does
# not report pending-reboot, schedule-overdue, denial, or deferral details.
HEIMDALL_MAINTENANCE_RESULT_TOKEN=          # dedicated Bearer token (REQUIRED before producer delivery is enabled)

# ── Brokkr systemd supervision evidence (read-only observer) ───────────────
# POST /api/systemd-supervision accepts only the closed, content-blind Brokkr
# systemd-supervision-audit v1 envelope. A dedicated Bearer is always required;
# there is no localhost bypass and no restart/enable/disable API.
HEIMDALL_SUPERVISION_TOKEN=                 # dedicated Bearer token (REQUIRED before producer delivery is enabled)

# ── Optional remote storage collector ───────────────────────────────────────
HEIMDALL_STORAGE_SSH_HOST=192.0.2.20        # RFC 5737 example; replace in a real deployment
HEIMDALL_STORAGE_SSH_USER=heimdall
HEIMDALL_STORAGE_SSH_KEY=                  # required dedicated private key; no personal-identity fallback

# ── Optional autonomous recovery ────────────────────────────────────────────
# Disabled by default. Enabling this submits Hugin tasks whose effective powers
# come from Hugin's runtime, SSH keys, and sudo policy—not from Heimdall's cooldown.
HEIMDALL_SELF_HEAL_ENABLED=0
HEIMDALL_MONITOR_CLOUDFLARED=0              # optional provider-specific liveness alert
