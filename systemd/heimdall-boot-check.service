[Unit]
Description=Heimdall local service health reconciliation
After=network-online.target tailscaled.service heimdall.service
Wants=network-online.target

[Service]
Type=oneshot
User=<user>
WorkingDirectory=<deploy-path>
ExecStart=/usr/bin/node src/boot-check.js
Environment=NODE_ENV=production
Environment=DB_PATH=<home>/.heimdall/heimdall.db
EnvironmentFile=<home>/.heimdall/env

# Sandboxing — needs DB write access and read access to the repo + network (no SSH).
# Node's JIT requires executable memory; do not set MemoryDenyWriteExecute=yes.
ProtectSystem=strict
ReadWritePaths=<home>/.heimdall
ReadOnlyPaths=<deploy-path>
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
SystemCallArchitectures=native
