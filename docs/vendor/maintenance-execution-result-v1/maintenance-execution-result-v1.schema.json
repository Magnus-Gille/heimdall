{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/maintenance-execution-result/v1/schema.json",
  "title": "Brokkr maintenance execution result v1",
  "description": "Closed, metadata-only read model of authoritative ADR-008 v2 maintenance evidence. It is not a lifecycle, command, policy, or actuation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "result_id", "source", "freshness", "execution_epoch", "journal", "receipt", "probe_coverage", "reconciliation", "phase", "outcome", "health", "promotion_eligible", "recovery", "result_digest", "extensions"],
  "properties": {
    "kind": { "const": "maintenance-execution-result" },
    "schema_version": { "const": "v1" },
    "result_id": { "$ref": "#/$defs/id" },
    "source": { "$ref": "#/$defs/source" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "execution_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "journal": { "$ref": "#/$defs/journal" },
    "receipt": { "$ref": "#/$defs/receipt" },
    "probe_coverage": { "$ref": "#/$defs/probe-coverage" },
    "reconciliation": { "enum": ["reconciled", "unreconciled", "failed"] },
    "phase": { "enum": ["prepare", "apply", "verify", "watch", "commit", "unknown", "recover", "quarantine", "disarm", "terminally-blocked"] },
    "outcome": { "enum": ["clean", "unknown", "stale", "unreconciled", "failed", "recovered-by-worker", "disarmed", "terminally-blocked"] },
    "health": { "enum": ["healthy", "unknown", "unhealthy"] },
    "promotion_eligible": { "type": "boolean" },
    "recovery": { "$ref": "#/$defs/recovery" },
    "result_digest": { "$ref": "#/$defs/digest" },
    "extensions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$", "format": "date-time" },
    "journal-utc": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "source_revision_digest", "configuration_digest"], "properties": { "source_id": { "$ref": "#/$defs/id" }, "source_revision_digest": { "$ref": "#/$defs/digest" }, "configuration_digest": { "$ref": "#/$defs/digest" } } },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["observed_at", "valid_until", "evaluated_at"], "properties": { "observed_at": { "$ref": "#/$defs/utc" }, "valid_until": { "$ref": "#/$defs/utc" }, "evaluated_at": { "$ref": "#/$defs/utc" } } },
    "journal": { "type": "object", "additionalProperties": false, "required": ["journal_id", "binding_digest", "config_digest", "tail_sequence", "tail_recorded_at", "tail_receipt_digest", "watch_anchor"], "properties": { "journal_id": { "$ref": "#/$defs/id" }, "binding_digest": { "$ref": "#/$defs/digest" }, "config_digest": { "$ref": "#/$defs/digest" }, "tail_sequence": { "type": "integer", "minimum": 1 }, "tail_recorded_at": { "$ref": "#/$defs/journal-utc" }, "tail_receipt_digest": { "$ref": "#/$defs/digest" }, "watch_anchor": { "$ref": "#/$defs/nullable-watch-anchor" } } },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_digest", "journal_id", "binding_digest", "journal_tail_digest", "reconciliation"], "properties": { "receipt_id": { "$ref": "#/$defs/id" }, "receipt_digest": { "$ref": "#/$defs/digest" }, "journal_id": { "$ref": "#/$defs/id" }, "binding_digest": { "$ref": "#/$defs/digest" }, "journal_tail_digest": { "$ref": "#/$defs/digest" }, "reconciliation": { "enum": ["reconciled", "unreconciled", "failed"] } } },
    "probe-coverage": { "type": "object", "additionalProperties": false, "required": ["expected_count", "observed_count", "state"], "properties": { "expected_count": { "type": "integer", "minimum": 0, "maximum": 1024 }, "observed_count": { "type": "integer", "minimum": 0, "maximum": 1024 }, "state": { "enum": ["complete", "incomplete", "unknown"] } } },
    "watch-anchor": { "type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "journal_id", "mutation_id", "attempt_id", "target_scope_digest", "candidate_digest", "binding_digest", "journal_tail_digest", "anchored_at", "anchor_digest"], "properties": { "kind": { "const": "brokkr-durable-watch-anchor" }, "schema_version": { "const": "v1" }, "journal_id": { "$ref": "#/$defs/id" }, "mutation_id": { "$ref": "#/$defs/id" }, "attempt_id": { "$ref": "#/$defs/id" }, "target_scope_digest": { "$ref": "#/$defs/digest" }, "candidate_digest": { "$ref": "#/$defs/digest" }, "binding_digest": { "$ref": "#/$defs/digest" }, "journal_tail_digest": { "$ref": "#/$defs/digest" }, "anchored_at": { "$ref": "#/$defs/journal-utc" }, "anchor_digest": { "$ref": "#/$defs/digest" } } },
    "nullable-watch-anchor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/watch-anchor" }] },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["state", "reason_digest"], "properties": { "state": { "enum": ["not-required", "unknown", "failed", "recovered-by-worker", "disarmed", "terminally-blocked"] }, "reason_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] } } }
  }
}
