  "batch_cases": [
    {
      "name": "record ID collision",
      "mutations": [
        {
          "record_id": "ref:rec-worker",
          "patch": {
            "summary": "Different payload with the same stable record ID."
          },
          "duplicate": true
        }
      ]
    },
    {
      "name": "dangling close source",
      "mutations": [
        {
          "record_id": "ref:rec-close",
          "patch": {
            "source_observation_ref": "ref:missing-observation"
          }
        }
      ]
    },
    {
      "name": "observation source cycle",
      "mutations": [
        {
          "record_id": "ref:rec-worker",
          "patch": {
            "reporter": {
              "id": "ref:report-worker",
              "kind": "parent",
              "requested_model": null,
              "observed_model": null,
              "observed_effort": null
            },
            "source_observation_ref": "ref:rec-close"
          }
        }
      ]
    },
    {
      "name": "dangling assessment observation",
      "mutations": [
        {
          "record_id": "ref:assess-main",
          "patch": {
            "observation_refs": [
              "ref:missing-observation"
            ]
          }
        }
      ]
    },
    {
      "name": "assessment references another task",
      "mutations": [
        {
          "record_id": "ref:assess-main",
          "patch": {
            "observation_refs": [
              "ref:rec-env-code"
            ]
          }
        }
      ]
    },
    {
      "name": "correction target absent",
      "mutations": [
        {
          "record_id": "ref:assess-main-corrected",
          "patch": {
            "supersedes_record_id": "ref:missing-assessment"
          }
        }
      ]
    },
    {
      "name": "correction target has another attempt",
      "mutations": [
        {
          "record_id": "ref:assess-main-corrected",
          "patch": {
            "supersedes_record_id": "ref:rec-worker"
          }
        }
      ]
    },
    {
      "name": "correction cycle",
      "mutations": [
        {
          "record_id": "ref:assess-main",
          "patch": {
            "supersedes_record_id": "ref:assess-main-corrected",
            "correction_ref": "ref:correction-backwards"
          }
        }
      ]
    },
    {
      "name": "child lineage mismatch",
      "mutations": [
        {
          "record_id": "ref:rec-worker",
          "patch": {
            "parent_attempt_id": "unlisted-parent"
          }
        }
      ]
    },
    {
      "name": "attempt ancestry cycle",
      "mutations": [
        {
          "record_id": "ref:assess-main",
          "patch": {
            "parent_attempt_id": "child-attempt"
          }
        }
      ]
    }
  ]
}
