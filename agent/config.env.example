# Heimdall fleet push-agent configuration
# Copy to config.env and fill in values.

# Required: URL of the Heimdall ingest endpoint
HUB_URL=http://192.0.2.10:3033/api/fleet/push

# Optional: Bearer token for authentication (required in production)
FLEET_TOKEN=

# Push interval in seconds (default: 30)
INTERVAL=30

# Optional v1 capability negotiation. Keep deployment-specific evidence in the
# protected overlay; never include endpoints, credentials, topology, workloads,
# or private locations. Example:
# CAPABILITY_CONTRACT_JSON={"version":1,"required":["node-capability-freshness"]}

# Override the reported hostname (important: set HOSTNAME=workstation for the laptop
# to match the server fleet config which marks it always_on:false)
# HOSTNAME=workstation
