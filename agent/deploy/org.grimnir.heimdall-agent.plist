<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.grimnir.heimdall-agent</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Program</key>
    <string>/usr/bin/python3</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOURUSERNAME/repos/heimdall/agent/core.py</string>
    </array>
    <!-- core.py reads config.env from its own directory. -->
    <key>StandardOutPath</key>
    <string>/tmp/heimdall-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/heimdall-agent.err</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
